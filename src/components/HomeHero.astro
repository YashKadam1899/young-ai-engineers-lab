---
// Homepage section 1 of 9: hero — the single <h1> plus the two primary CTAs.
//
// Scene 1 slot. The copy lives here; the art and the arrangement around it
// come from one version in ./hero-scenes/. To switch versions, change the
// HeroScene import below: that one line is the whole switch. Blobs is the
// original 2.0 hero, kept so any other version can be undone in one line.
import HeroScene from './hero-scenes/LabArrival.astro';
import { EMAILS, mailto } from '../emails';

// Same base-joining rule as the header: hrefs are relative to Astro's `base`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section data-beat="arrival" class="relative overflow-hidden bg-surface">
  <HeroScene>
    <h1 class="font-display text-hero text-balance font-bold tracking-tight text-fg">
      Turning India's <span class="whitespace-nowrap">10–15 year-olds</span> from AI consumers into AI developers
    </h1>
    <div class="mt-9 flex flex-col sm:flex-row justify-center gap-4">
      <a href={mailto(EMAILS.learn, 'Winter Batch signup')} class="rounded-full bg-cta px-6 py-3.5 text-cta-fg font-semibold shadow-lg shadow-cta/25 transition-all hover:-translate-y-0.5 hover:bg-cta-hover hover:shadow-xl hover:shadow-cta/30">Sign Up for the Winter Batch</a>
      <a href={`${base}/for-investors/`} class="rounded-full border-2 border-line-medium bg-surface-raised px-6 py-3.5 text-fg-secondary font-semibold transition-all hover:-translate-y-0.5 hover:border-line-strong hover:bg-surface-tint">See the Investor Overview</a>
    </div>
  </HeroScene>
</section>
