---
// Homepage section 6 of 9 — Scene 6, "The teacher". The instructor credential,
// written on the green board at the front of the lab: a teak frame, chalk on
// the ledge, the teacher beat's warm wall around it. It is the counterpoint to
// every automated screen above it, so no person is drawn (people need real
// artwork) and motion is one slow settle of the writing, nothing else.

// Same base-joining rule as the header: hrefs are relative to Astro's `base`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section data-beat="teacher" class="bg-surface">
  <div class="max-w-content mx-auto px-gutter py-section">
    <div
      data-teacher-board
      class="relative overflow-hidden rounded-md border-8 border-accent bg-surface-inverse text-white shadow-xl shadow-accent/15 sm:border-[12px]"
    >
      {/* Old eraser marks: every real board has them. Decoration only. */}
      <div aria-hidden="true" class="pointer-events-none absolute -left-20 top-4 h-40 w-[30rem] -rotate-6 rounded-full bg-white/[0.04] blur-2xl"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -right-16 bottom-2 h-32 w-96 rotate-3 rounded-full bg-white/[0.03] blur-2xl"></div>

      <div class="relative grid grid-cols-1 items-center gap-8 px-5 py-10 sm:px-10 sm:py-12 md:grid-cols-5 lg:px-14">
        <div class="teacher-settle md:col-span-3">
          <p class="text-xs font-semibold uppercase tracking-wider text-accent-soft">Who teaches it</p>
          <h2 class="mt-3 font-display text-h2 font-bold">
            An IIT Bombay alumnus joining as instructor for <span class="teacher-chalk relative whitespace-nowrap">each session<svg aria-hidden="true" focusable="false" viewBox="0 0 200 12" preserveAspectRatio="none" fill="none" class="pointer-events-none absolute -bottom-2 left-0 h-3 w-full text-accent-soft"><path d="M3 8.5 C 38 4, 82 10, 124 6 S 180 6.5, 197 4" stroke="currentColor" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke" opacity="0.85" /></svg></span>
          </h2>
          <p class="mt-4 text-fg-inverse/80">
            Our co-founder and Head of Curriculum is an IIT Bombay alumnus and a working AI/ML practitioner — and he is in the room for every single session, not just the first one. No recorded video course, and no script read out by a part-time tutor: your child is learning from someone who builds AI systems for a living.
          </p>
          <a href={`${base}/our-team/`} class="mt-6 inline-block rounded-full border-2 border-line-strong px-5 py-2.5 text-small font-semibold text-white transition-[color,background-color,border-color,scale] hover:border-accent-soft hover:bg-accent active:scale-[0.97]">
            Meet the team
          </a>
        </div>
        <div class="teacher-settle teacher-settle-late rounded-lg border border-white/15 bg-white/5 p-6 md:col-span-2">
          <p class="font-display text-h3 font-semibold">The founding cohort is the proof</p>
          <p class="mt-2 text-small text-fg-inverse/70">
            We're deliberately running one strong cohort — taught by the founders, ending in a parent-attended Demo Day — before we pitch a single school. The students' work is the case study.
          </p>
        </div>
      </div>
    </div>

    {/* The chalk ledge under the board: two sticks of chalk and a duster. */}
    <div aria-hidden="true" class="relative -mt-1 h-3 rounded-b-md border-t border-white/10 bg-accent-strong shadow-md sm:h-4">
      <span class="absolute bottom-full left-[9%] h-1.5 w-9 rounded-full bg-white/90 sm:h-2 sm:w-11"></span>
      <span class="absolute bottom-full left-[calc(9%+3rem)] h-1.5 w-6 rounded-full bg-accent-soft sm:left-[calc(9%+3.75rem)] sm:h-2 sm:w-7"></span>
      <span class="absolute bottom-full right-[10%] w-14 overflow-hidden rounded-sm shadow-sm sm:w-[4.5rem]">
        <span class="block h-2.5 bg-accent sm:h-3"></span>
        <span class="block h-1.5 bg-fg-subtle sm:h-2"></span>
      </span>
    </div>
  </div>
</section>

<style>
  /* One slow settle of the writing on the board; the board itself never moves.
     The before-state applies only when the layout's motion flag is set and the
     script below has marked the board as still to come, so with reduced
     motion, or with JS off, everything is simply there. */
  .teacher-settle {
    --teacher-ease: cubic-bezier(0.23, 1, 0.32, 1);
  }

  :global(html[data-motion='ok']) [data-teacher-board][data-settle='pending'] .teacher-settle {
    opacity: 0;
    transform: translateY(10px);
  }

  [data-teacher-board][data-settle='done'] .teacher-settle {
    transition:
      opacity 700ms var(--teacher-ease),
      transform 700ms var(--teacher-ease);
  }

  [data-teacher-board][data-settle='done'] .teacher-settle-late {
    transition-delay: 120ms;
  }

  /* Print shows the board too, even if it never scrolled into view. */
  @media print, (prefers-reduced-motion: reduce) {
    .teacher-settle {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  // Mark the board as still to come only if it starts below the fold, so a
  // board already on screen at load never blinks out and back in.
  if (document.documentElement.dataset.motion === 'ok' && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          (entry.target as HTMLElement).dataset.settle = 'done';
          io.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -15% 0px' },
    );
    for (const board of document.querySelectorAll<HTMLElement>('[data-teacher-board]')) {
      if (board.getBoundingClientRect().top < window.innerHeight) continue;
      board.dataset.settle = 'pending';
      io.observe(board);
    }
  }
</script>
