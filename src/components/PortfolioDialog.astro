---
// An "example entry": a card on the page that opens the full entry (carousel
// plus the four questions) in a native <dialog>. The dialog is in the server-
// rendered HTML, closed, so crawlers and readers see all of it.
//
// Without JS a dialog cannot open, so the card must not look like a dead
// button. The page ships ONE plain card with a real <h3>. The script wraps the
// title text in a <button data-open> (accessible name = the title) whose ::after
// stretches over the whole card, and reveals the "Open project" hint, whose
// height is already reserved, so nothing shifts.
//
// The "Example" label is rendered here, on the card and in the dialog: none
// of these entries is a real student's work.
//
// Heading outline: page h1 > section h2 > this component's h3 (card and
// dialog title).
import PortfolioCarousel from './PortfolioCarousel.astro';
import PortfolioQA from './PortfolioQA.astro';
import type { PortfolioEntry } from '../content/portfolio';

interface Props {
  entry: PortfolioEntry;
}

const { entry } = Astro.props;
const titleId = `pd-title-${entry.id}`;
---
<div data-pdialog data-entry={entry.id} class="pd">
  <div class="pd-card">
    <span class="pd-chip pd-chip-example">Example</span>
    <h3 class="pd-card-title" data-pd-title>{entry.title}</h3>
    <p class="pd-card-summary">{entry.summary}</p>
    <ul class="pd-tags">
      {entry.tags.map((t) => <li class="pd-chip">{t}</li>)}
    </ul>
    <!-- Height reserved in the HTML; hidden (and out of the accessibility tree) until JS makes the card an opener. -->
    <p class="pd-open" data-pd-hint aria-hidden="true">
      Open project
      <svg aria-hidden="true" viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4 6 6-6 6" /></svg>
    </p>
  </div>

  <dialog aria-labelledby={titleId} data-pd-dialog class="pd-dialog">
    <div class="pd-head">
      <div class="pd-head-text">
        <h3 id={titleId} class="pd-dialog-title">{entry.title}</h3>
      </div>
      <button type="button" data-pd-close aria-label="Close" class="pd-close">
        <svg aria-hidden="true" viewBox="0 0 20 20" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"><path d="m5 5 10 10M15 5 5 15" /></svg>
      </button>
    </div>
    <div class="pd-body">
      <p class="pd-note">A placeholder project, shown to explain how an entry looks. Not a real student's work.</p>
      <div class="pd-carousel">
        <PortfolioCarousel slides={entry.slides} label={`${entry.title}: example slides`} compact />
      </div>
      <PortfolioQA qa={entry.qa} group={entry.id} />
    </div>
  </dialog>
</div>

<style>
  .pd-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    width: 100%;
    height: 100%;
    padding: 1.375rem;
    text-align: left;
    color: var(--color-fg);
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
    border-radius: 1rem;
  }
  .pd-card {
    position: relative;
  }
  .pd :global(.pd-title-btn) {
    all: unset;
    cursor: pointer;
  }
  .pd :global(.pd-title-btn)::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1rem;
  }
  .pd :global(.pd-title-btn):focus-visible::after {
    outline: 3px solid var(--color-focus, var(--color-fg));
    outline-offset: 3px;
  }
  /* Nothing under the pointer moves on hover (a moving hit area makes clicks
     unstable); the lift is a shadow. Hover only where there is a real mouse. */
  .pd[data-pd-ready] .pd-card {
    transition:
      border-color 150ms var(--motion-ease-out),
      box-shadow 150ms var(--motion-ease-out),
      transform 120ms var(--motion-ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .pd[data-pd-ready] .pd-card:hover {
      border-color: var(--color-line-strong);
      box-shadow: 0 2px 0 var(--color-line-strong);
    }
    .pd[data-pd-ready] .pd-card:hover .pd-open svg {
      transform: translateX(3px);
    }
  }
  .pd[data-pd-ready] .pd-card:active {
    transform: scale(0.985);
  }
  .pd-card-title {
    font-family: var(--font-display, inherit);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1.2;
    margin: 0;
  }
  .pd-card-summary {
    color: var(--color-fg-muted);
    margin: 0;
  }
  .pd-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pd-chip {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-fg);
    background: var(--color-surface-tint);
    border: 1px solid var(--color-line);
    border-radius: 999px;
  }
  .pd-chip-example {
    background: var(--color-highlight);
    border-color: var(--color-highlight);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pd-open {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    margin-top: auto;
    font-family: var(--font-display, inherit);
    font-weight: 700;
    color: var(--color-accent-strong);
  }

  /* The hint takes its space always, but only shows once JS has made the card an opener. */
  .pd-open {
    visibility: hidden;
  }
  .pd[data-pd-ready] .pd-open {
    visibility: visible;
  }
  .pd-open svg {
    transition: transform 150ms var(--motion-ease-out);
  }
  /* Without JS there is no opener, so no hint and no reserved strip. */
  @media (scripting: none) {
    .pd-open {
      display: none;
    }
  }

  .pd-dialog {
    width: min(32rem, calc(100% - 2rem));
    max-height: 90dvh;
    margin: auto;
    padding: 0;
    color: var(--color-fg);
    background: var(--color-surface);
    border: 1px solid var(--color-line-strong);
    border-radius: 1rem;
    overflow: hidden;
    /* Closed state = exit: shorter than the entrance. */
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    transition:
      opacity 140ms var(--motion-ease-out),
      transform 140ms var(--motion-ease-out),
      overlay 140ms allow-discrete,
      display 140ms allow-discrete;
  }
  .pd-dialog[open] {
    display: flex;
    flex-direction: column;
    opacity: 1;
    transform: none;
    transition:
      opacity 180ms var(--motion-ease-out),
      transform 180ms var(--motion-ease-out),
      overlay 180ms allow-discrete,
      display 180ms allow-discrete;
  }
  @starting-style {
    .pd-dialog[open] {
      opacity: 0;
      transform: translateY(8px) scale(0.96);
    }
  }
  .pd-dialog::backdrop {
    background: color-mix(in oklab, var(--color-surface-inverse) 60%, transparent);
    opacity: 0;
    transition:
      opacity 140ms var(--motion-ease-out),
      overlay 140ms allow-discrete,
      display 140ms allow-discrete;
  }
  .pd-dialog[open]::backdrop {
    opacity: 1;
    transition-duration: 180ms;
  }
  @starting-style {
    .pd-dialog[open]::backdrop {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pd-dialog,
    .pd-dialog[open] {
      transform: none;
    }
    .pd[data-pd-ready] .pd-card:active {
      transform: none;
    }
    .pd-open svg {
      transition: none;
    }
    .pd[data-pd-ready] .pd-card:hover .pd-open svg {
      transform: none;
    }
    @starting-style {
      .pd-dialog[open] {
        transform: none;
      }
    }
  }

  /* Phones: a bottom sheet that slides up. */
  @media (max-width: 640px) {
    .pd-dialog {
      width: 100%;
      max-width: 100%;
      margin: auto 0 0;
      border-bottom: 0;
      border-radius: 1rem 1rem 0 0;
      transform: translateY(100%);
    }
    @starting-style {
      .pd-dialog[open] {
        transform: translateY(100%);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .pd-dialog {
        transform: none;
      }
      @starting-style {
        .pd-dialog[open] {
          transform: none;
        }
      }
    }
  }
  /* Short screens (phones in landscape): use the height there is. */
  @media (max-height: 480px) {
    .pd-dialog {
      max-height: calc(100dvh - 0.5rem);
    }
    .pd-dialog .pd-body {
      padding-block: 0.5rem 0.75rem;
      gap: 0.5rem;
    }
  }

  /* Without JS the dialog can never open, so show its content in the page,
     below the card, with no dialog chrome. */
  @media (scripting: none) {
    .pd .pd-dialog {
      display: block;
      position: static;
      width: 100%;
      max-width: none;
      max-height: none;
      margin: 1rem 0 0;
      opacity: 1;
      transform: none;
      transition: none;
      overflow: visible;
    }
    .pd .pd-card {
      height: auto;
    }
    .pd .pd-head {
      display: none;
    }
    .pd .pd-carousel {
      height: auto;
    }
  }
  .pd-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0.75rem 0.5rem 1.25rem;
    border-bottom: 1px solid var(--color-line);
    flex-shrink: 0;
  }
  .pd-head-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
    padding-top: 0.5rem;
    min-width: 0;
  }
  .pd-dialog-title {
    font-family: var(--font-display, inherit);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1.2;
    margin: 0;
  }
  .pd-close {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-fg);
    background: var(--color-surface-tint);
    border: 1px solid var(--color-line);
    border-radius: 999px;
    cursor: pointer;
  }
  .pd-close:focus-visible {
    outline: 3px solid var(--color-focus, var(--color-fg));
    outline-offset: 2px;
  }
  .pd-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 0;
    padding: 1rem 1.25rem 1.25rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .pd-note {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-fg-muted);
  }
  .pd-carousel {
    height: clamp(14rem, 100dvh - 11rem, 22rem);
    flex-shrink: 0;
    overflow: hidden;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-line);
    border-radius: 0.75rem;
  }
</style>

<style is:global>
  /* Lock the page behind an open modal dialog. */
  html:has(dialog[open]) {
    overflow: hidden;
  }
  /* Keep the scrollbar's space always, so hiding it (classic scrollbars) does
     not make the page jump sideways. Declared on pages that have a dialog,
     not toggled on open: Chromium ignores a gutter that appears at the same
     moment as overflow:hidden. */
  html:has([data-pdialog]) {
    scrollbar-gutter: stable;
  }
</style>

<script>
  // One setup per component root, so several dialogs on a page don't interfere.
  for (const root of document.querySelectorAll<HTMLElement>('[data-pdialog]')) {
    const title = root.querySelector<HTMLElement>('[data-pd-title]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-pd-dialog]');
    const closeBtn = root.querySelector<HTMLButtonElement>('[data-pd-close]');
    if (!title || !dialog || !closeBtn) continue;

    const opener = document.createElement('button');
    opener.type = 'button';
    opener.className = 'pd-title-btn';
    opener.setAttribute('data-open', root.dataset.entry ?? "");
    opener.setAttribute('aria-haspopup', 'dialog');
    opener.textContent = title.textContent;
    title.replaceChildren(opener);
    root.setAttribute('data-pd-ready', '');

    const reset = () => {
      dialog.querySelector('[data-qa-root]')?.dispatchEvent(new Event('qa:reset'));
      dialog.querySelector('[data-carousel]')?.dispatchEvent(new Event('carousel:reset'));
      const body = dialog.querySelector<HTMLElement>('.pd-body');
      if (body) body.scrollTop = 0;
    };

    opener.addEventListener('click', () => {
      if (!dialog.open) dialog.showModal();
      // A closed dialog is display:none, so its track cannot be scrolled back
      // then. Reset again now that it is rendered.
      reset();
    });
    closeBtn.addEventListener('click', () => dialog.close());
    // A click whose target is the dialog itself landed on the backdrop.
    // Only if the press also started there, so drag-selecting text out of the dialog does not close it.
    let downOnBackdrop = false;
    dialog.addEventListener('pointerdown', (e) => {
      downOnBackdrop = e.target === dialog;
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog && downOnBackdrop) dialog.close();
      downOnBackdrop = false;
    });
    // Runs for Esc, the close button and the backdrop alike.
    // No reset here: the dialog fades out, and resetting now would flash
    // slide 1 and closed accordions. It is reset when next opened.
    dialog.addEventListener('close', () => {
      opener.focus();
    });
  }
</script>
