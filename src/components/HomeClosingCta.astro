---
// Homepage section 10 of 10 - Scene 7, "What they made": the closing CTA card,
// with the finished artifact beside it. The sign-up copy and buttons come
// first (left on wide screens, on top on phones) and never wait for motion;
// only the artifact screen reveals, once.
import { EMAILS, SIGNUP_FORM_URL, mailto } from '../emails';
import PortfolioEntryScreen from './PortfolioEntryScreen.astro';

// Same base-joining rule as the header: hrefs are relative to Astro's `base`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ctaClass =
  'w-full rounded-full bg-cta px-6 py-3.5 font-semibold text-cta-fg shadow-lg shadow-cta/25 transition-[translate,scale,background-color,box-shadow] hover:-translate-y-0.5 hover:bg-cta-hover active:translate-y-0 active:scale-[0.97] sm:w-auto';
---
<section data-beat="payoff" class="bg-surface">
  <div class="max-w-content mx-auto px-gutter pb-section pt-4">
    <div class="relative overflow-hidden rounded-2xl bg-surface-inverse px-5 py-section text-white sm:px-10 lg:px-14">
      <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 h-56 w-56 rounded-full bg-glow-inverse/30 blur-3xl"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -left-10 h-56 w-56 rounded-full bg-cta/20 blur-3xl"></div>
      <div class="relative grid grid-cols-1 items-center gap-stack lg:grid-cols-2 lg:gap-14">
        <div class="text-center lg:text-left">
          <h2 class="font-display text-h2 font-bold">Your child is already using AI</h2>
          <p class="mx-auto mt-4 max-w-prose text-fg-inverse/80 lg:mx-0">
            The founding batch of the Winter Lab is open right now: the 12-session main program, taught live online over 6 weeks, so a student can join from any city. This is where they learn to build with AI. Fill in the short sign-up form and we will email payment instructions to the address you give.
          </p>
          <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap sm:whitespace-nowrap lg:justify-start">
            <a
              href={SIGNUP_FORM_URL}
              target="_blank"
              rel="noopener noreferrer"
              class={ctaClass}
            >
              Sign up for the Winter Batch<span class="sr-only"> (opens the sign-up form in a new tab)</span>
            </a>
            <a
              href={mailto(EMAILS.partner, 'School seminar booking')}
              class={ctaClass}
            >
              Schools: Book your free seminars
            </a>
          </div>
          <p class="mt-6 text-small text-fg-inverse/60">
            <a href={`${base}/contact/`} class="font-semibold text-accent-inverse underline underline-offset-4 hover:text-white">Other ways to reach us</a>
          </p>
        </div>
        <PortfolioEntryScreen />
      </div>
    </div>
  </div>
</section>
