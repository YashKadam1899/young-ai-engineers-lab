---
// Homepage section 10 of 10 — Scene 7, "What they made": the closing CTA card,
// with the finished artifact beside it. The sign-up copy and buttons come
// first (left on wide screens, on top on phones) and never wait for motion;
// only the artifact screen reveals, once.
import { EMAILS, mailto } from '../emails';
import PortfolioEntryScreen from './PortfolioEntryScreen.astro';

// Same base-joining rule as the header: hrefs are relative to Astro's `base`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section data-beat="payoff" class="bg-surface">
  <div class="max-w-content mx-auto px-gutter pb-section pt-4">
    <div class="relative overflow-hidden rounded-2xl bg-surface-inverse px-5 py-section text-white sm:px-10 lg:px-14">
      <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 h-56 w-56 rounded-full bg-glow-inverse/30 blur-3xl"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -left-10 h-56 w-56 rounded-full bg-cta/20 blur-3xl"></div>
      <div class="relative grid grid-cols-1 items-center gap-stack lg:grid-cols-2 lg:gap-14">
        <div class="text-center lg:text-left">
          <h2 class="font-display text-h2 font-bold">Sign up for the Winter Batch</h2>
          <p class="mx-auto mt-4 max-w-prose text-fg-inverse/80 lg:mx-0">
            The founding batch of the Winter Lab is open right now — the 12-session main program, taught live online over 6 weeks, so a student can join from any city. Your child is already using AI — this is where they learn to build with it. Send one email and we will reply with the dates, the fees and exactly what your child will build.
          </p>
          <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:flex-wrap sm:whitespace-nowrap lg:justify-start">
            <a
              href={mailto(EMAILS.learn, 'Winter Batch signup')}
              class="w-full rounded-full bg-cta px-6 py-3.5 font-semibold text-cta-fg shadow-lg shadow-cta/25 transition-[translate,scale,background-color,box-shadow] hover:-translate-y-0.5 hover:bg-cta-hover active:translate-y-0 active:scale-[0.97] sm:w-auto"
            >
              Sign up for the Winter Batch
            </a>
            <a
              href={`${base}/contact/`}
              class="w-full rounded-full border-2 border-white/25 px-6 py-3.5 font-semibold text-white transition-[color,background-color,border-color,scale] hover:border-white/60 hover:bg-white/10 active:scale-[0.97] sm:w-auto"
            >
              Other ways to reach us
            </a>
          </div>
          <p class="mt-6 text-small text-fg-inverse/60">
            Schools and sponsors: partnerships are planned after the founding cohort; email <a href={mailto(EMAILS.partner, 'School or sponsor interest')} class="font-semibold wrap-anywhere text-accent-inverse underline underline-offset-4 hover:text-white">{EMAILS.partner}</a> to hear when they open.
          </p>
        </div>
        <PortfolioEntryScreen />
      </div>
    </div>
  </div>
</section>
