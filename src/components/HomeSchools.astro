---
// Homepage section 8 of 10: a compact note on school and sponsor partnerships.
// Partnerships are planned after the founding cohort. Keep this to one short
// note and a way to hear when they open: no formats, funding or seats.
import { EMAILS, mailto } from '../emails';
---
<section data-beat="building" class="bg-surface">
  <div class="max-w-content mx-auto px-gutter py-section">
    <div class="rounded-2xl border border-line bg-surface-raised p-6 shadow-sm sm:p-8" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-wider text-accent">Schools and sponsors</p>
      <h2 class="mt-3 font-display text-h2 font-bold text-fg">Partnerships come after our founding cohort</h2>
      <p class="mt-3 max-w-prose text-fg-muted">
        School and sponsor partnerships are planned after the founding cohort. When schools are onboarded, our live online sessions will run for the classroom. If you would like to hear when partnerships open, send us a note at{' '}
        <a
          href={mailto(EMAILS.partner, 'School or sponsor interest')}
          class="font-semibold wrap-anywhere text-accent underline decoration-link-underline decoration-2 underline-offset-4 hover:text-accent-strong"
        >{EMAILS.partner}</a>.
      </p>
    </div>
  </div>
</section>
