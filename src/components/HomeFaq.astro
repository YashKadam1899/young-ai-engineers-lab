---
// Homepage section 8 of 9: the FAQ, as native <details>/<summary> (no JS).
//
// The `faqs` array deliberately lives in src/content/faqs.ts rather than here:
// index.astro feeds that same array to faqPageSchema() for the FAQPage JSON-LD.
// One source, so the structured data cannot drift from the visible Q&A. Never
// copy or fork this array into a second place.
import { faqs } from '../content/faqs';
---
<section data-beat="calm" id="faq" class="bg-surface">
  <div class="max-w-narrow mx-auto px-gutter py-section">
    <h2 class="font-display text-h2 font-bold text-fg text-center">Questions parents ask us first</h2>
    <div class="mt-stack space-y-3">
      {faqs.map((f) => (
        <details class="group rounded-2xl border border-line bg-surface-raised p-5 shadow-sm transition-shadow hover:shadow-md">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
            <span class="font-display font-semibold text-fg">{f.q}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-accent transition-transform duration-200 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="mt-3 text-small text-fg-muted">{f.a}</p>
          {f.cta && (
            <a href={f.cta.href} class="mt-3 inline-block text-small font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 transition-colors hover:text-accent-strong">
              {f.cta.label}
            </a>
          )}
          {f.more && (
            <a href={f.more.href} class="mt-3 inline-block text-small font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 transition-colors hover:text-accent-strong">
              {f.more.label}
            </a>
          )}
        </details>
      ))}
    </div>
  </div>
</section>
