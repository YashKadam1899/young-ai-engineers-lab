---
// Portfolio question-and-answer accordion. Native <details name={group}>, so
// supporting browsers keep one item open at a time with no script. All closed
// on load. The question is the <summary> text only: no heading level is chosen
// here, so the host page keeps its own outline. Fills its parent's width, so it
// works in the page column and in the smaller pop-up alike.
import type { QA } from '../content/portfolio';

interface Props {
  qa: QA[];
  /** Shared `name` of the group; unique per instance on a page. */
  group: string;
}

const { qa, group } = Astro.props;
---
<div class="pqa w-full space-y-2.5" data-qa-root>
  {qa.map((item) => (
    <details name={group} class="pqa-item group rounded-[14px] border border-l-[3px] border-line border-l-transparent bg-surface-raised transition-[border-color] duration-200 ease-(--motion-ease-out) open:border-l-accent motion-reduce:transition-none">
      <summary class="pqa-summary flex min-h-12 cursor-pointer list-none items-center justify-between gap-3 rounded-[14px] px-5 py-[18px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [&::-webkit-details-marker]:hidden">
        <span class="font-display font-semibold text-fg group-open:text-[1.0625rem]">{item.q}</span>
        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-tint text-accent" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition-transform duration-200 ease-(--motion-ease-out) group-open:rotate-45 motion-reduce:transition-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
          </svg>
        </span>
      </summary>
      <div class="pqa-answer px-5 pb-5 pt-0">
        <p class="text-small text-fg-muted">{item.a}</p>
      </div>
    </details>
  ))}
</div>

<style>
  /* Same glide as the homepage FAQ (HomeFaq.astro): ::details-content block
     size and opacity over 250ms on the site's ease-out token. Chromium-only
     for now (interpolate-size); other browsers keep the instant toggle.
     Longhand properties on purpose, as in HomeFaq. */
  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      :global(html[data-motion='ok']) details {
        interpolate-size: allow-keywords;
      }
      :global(html[data-motion='ok']) details::details-content {
        block-size: 0;
        opacity: 0;
        overflow: clip;
        overflow-clip-margin: 8px;
        transition-property: block-size, opacity, content-visibility;
        transition-duration: 250ms;
        transition-timing-function: var(--motion-ease-out);
        transition-behavior: allow-discrete;
      }
      :global(html[data-motion='ok']) details[open]::details-content {
        block-size: auto;
        opacity: 1;
      }
      /* qa:reset closes everything at once, with no glide. */
      :global(html[data-motion='ok']) [data-qa-instant] details::details-content {
        transition-duration: 0s;
      }
    }
  }
</style>

<script>
  // Fallback for browsers without native `name` grouping: when one <details>
  // opens, close the others in the document sharing its name. Skipped where
  // the browser already does it.
  if (!('name' in HTMLDetailsElement.prototype)) {
    document.addEventListener(
      'toggle',
      (e) => {
        const d = e.target;
        if (!(d instanceof HTMLDetailsElement) || !d.open || !d.getAttribute('name') || !d.closest('[data-qa-root]')) return;
        document.querySelectorAll<HTMLDetailsElement>('[data-qa-root] details[open]').forEach((o) => {
          if (o !== d && o.getAttribute('name') === d.getAttribute('name')) o.open = false;
        });
      },
      true,
    );
  }

  // 'qa:reset' dispatched on a component root closes every item inside it.
  document.addEventListener(
    'qa:reset',
    (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;
      const root = t.closest('[data-qa-root]') ?? t;
      // Suppress the glide for this close, so reset never leaves a half-open state.
      root.setAttribute('data-qa-instant', '');
      root.querySelectorAll<HTMLDetailsElement>('details[open]').forEach((o) => {
        o.open = false;
      });
      requestAnimationFrame(() => requestAnimationFrame(() => root.removeAttribute('data-qa-instant')));
    },
    true,
  );
</script>
