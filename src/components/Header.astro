---
// Hrefs are relative to Astro's configured `base` (empty string here == the
// site root). Prefixing with `base` keeps links correct whether this deploys
// at a domain root (base: '/') or under a subpath (e.g. GitHub Pages
// project sites: base: '/young-ai-engineers-lab').
// Strip any trailing slash so we always join with exactly one '/' below,
// regardless of whether BASE_URL itself ends with one.
import { NAV_LINKS as links } from '../nav';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="sticky top-0 z-20 border-b border-indigo-100 bg-cream-100/90 backdrop-blur-sm">
  <nav class="max-w-5xl mx-auto flex items-center justify-between px-4 py-4">
    <a href={`${base}/`} class="font-display font-bold text-lg tracking-tight text-ink-950">
      Young <span class="text-indigo-600">AI</span> Engineers Lab
    </a>

    <ul class="hidden sm:flex gap-8 text-sm font-medium text-ink-600">
      {links.map((link) => (
        <li>
          <a
            href={`${base}/${link.href}`}
            class="relative pb-1 transition-colors hover:text-indigo-600 after:absolute after:left-0 after:-bottom-0.5 after:h-0.5 after:w-0 after:bg-coral-500 after:transition-all after:duration-200 hover:after:w-full"
          >{link.label}</a>
        </li>
      ))}
    </ul>

    <details class="sm:hidden relative">
      <summary class="list-none cursor-pointer p-2 -mr-2 rounded-md transition-colors hover:bg-indigo-50" aria-label="Open menu">
        <!-- Decorative: the <summary> carries the accessible name via aria-label. -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-ink-800" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <ul class="absolute right-0 mt-2 w-48 rounded-xl border border-indigo-100 bg-cream-50 shadow-xl py-2 text-sm font-medium text-ink-700 z-10">
        {links.map((link) => (
          <li><a href={`${base}/${link.href}`} class="block px-4 py-2.5 transition-colors hover:bg-indigo-50 hover:text-indigo-600">{link.label}</a></li>
        ))}
      </ul>
    </details>
  </nav>
</header>
