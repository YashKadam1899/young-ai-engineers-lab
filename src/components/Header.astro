---
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/our-team', label: 'Our Team' },
  { href: '/contact', label: 'Contact Us' },
  { href: '/for-investors', label: 'For Investors' },
];
---
<header class="border-b border-gray-200">
  <nav class="max-w-5xl mx-auto flex items-center justify-between px-4 py-4">
    <a href="/" class="font-bold text-lg text-slate-900">Young AI Engineers Lab</a>
    <ul class="flex gap-6 text-sm text-slate-700">
      {links.map((link) => (
        <li><a href={link.href} class="hover:text-orange-600">{link.label}</a></li>
      ))}
    </ul>
  </nav>
</header>
