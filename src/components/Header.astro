---
// Hrefs are relative to Astro's configured `base` (empty string here == the
// site root). Prefixing with `base` keeps links correct whether this deploys
// at a domain root (base: '/') or under a subpath (e.g. GitHub Pages
// project sites: base: '/young-ai-engineers-lab').
// Strip any trailing slash so we always join with exactly one '/' below,
// regardless of whether BASE_URL itself ends with one.
import { NAV_LINKS as links } from '../nav';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Current page, trailing-slash-normalised so dev (/about) and build (/about/) agree.
const here = Astro.url.pathname.replace(/\/?$/, '/');
const current = (href: string) => (here === `${base}/${href}` ? 'page' : undefined);
---
<header class="sticky top-0 z-20 border-b border-line bg-surface/90 backdrop-blur-sm">
  <nav aria-label="Main" class="max-w-content mx-auto flex items-center justify-between gap-3 px-gutter py-2 [@media(max-height:480px)]:py-0.5">
    <a href={`${base}/`} class="inline-flex min-h-11 min-w-0 items-center font-display leading-tight font-bold text-[clamp(0.75rem,4.4vw,1.125rem)] sm:text-lg tracking-tight text-fg">
      <span>Young <span class="text-accent">AI</span> Engineers Lab</span>
    </a>

    <!-- Inline bar from 1024px (lg); the hamburger takes over below. Exactly one is visible at any width. -->
    <ul class="hidden lg:flex gap-6 xl:gap-8 text-small font-medium text-fg-muted">
      {links.map((link) => (
        <li>
          <a
            href={`${base}/${link.href}`}
            aria-current={current(link.href)}
            class="relative flex min-h-11 items-center transition-colors hover:text-accent after:absolute after:left-0 after:bottom-1.5 after:h-0.5 after:w-0 after:bg-cta after:transition-all after:duration-200 hover:after:w-full aria-[current=page]:font-bold aria-[current=page]:text-accent aria-[current=page]:after:w-full"
          >{link.label}</a>
        </li>
      ))}
    </ul>

    <details class="lg:hidden relative">
      <summary class="flex h-11 w-11 items-center justify-center list-none cursor-pointer -mr-2.5 rounded-md transition-colors hover:bg-surface-tint" aria-label="Open menu">
        <!-- Decorative: the <summary> carries the accessible name via aria-label. -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-fg-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <ul class="absolute right-0 mt-2 w-48 max-h-[calc(100dvh-var(--header-h,5rem)-0.5rem)] overflow-y-auto overscroll-contain rounded-xl border border-line bg-surface-raised shadow-xl py-2 text-small font-medium text-fg z-10">
        {links.map((link) => (
          <li><a href={`${base}/${link.href}`} aria-current={current(link.href)} class="relative flex min-h-11 items-center px-4 py-2 transition-colors hover:bg-surface-tint hover:text-accent aria-[current=page]:font-bold aria-[current=page]:text-accent aria-[current=page]:bg-surface-tint aria-[current=page]:before:absolute aria-[current=page]:before:left-0 aria-[current=page]:before:inset-y-1.5 aria-[current=page]:before:w-1 aria-[current=page]:before:rounded-r aria-[current=page]:before:bg-cta">{link.label}</a></li>
        ))}
      </ul>
    </details>
  </nav>
</header>

<script>
  // Menu dismissal and state-aware name. Without JS the <details> still toggles.
  const d = document.querySelector('header details') as HTMLDetailsElement;
  const s = d.firstElementChild as HTMLElement;
  const hdr = d.closest('header') as HTMLElement;
  d.ontoggle = () => {
    s.ariaLabel = d.open ? 'Close menu' : 'Open menu';
    if (d.open) d.style.setProperty('--header-h', hdr.offsetHeight + 'px');
  };
  addEventListener('click', (e) => d.open && !d.contains(e.target as Node) && (d.open = false));
  addEventListener('keydown', (e) => e.key == 'Escape' && d.open && ((d.open = false), s.focus()));
  // Tabbing past the last item (or Shift+Tab out of the summary) closes the menu.
  d.addEventListener('focusout', (e) => {
    const to = e.relatedTarget as Node | null;
    if (d.open && to && !d.contains(to)) d.open = false;
  });
</script>
