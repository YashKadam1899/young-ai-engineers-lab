---
// Homepage section 2 of 9: the problem statement and two stat cards. Only
// figures with a primary source belong here (see docs/NEXT-STEPS.md P0.2).

// Same base-joining rule as the header: hrefs are relative to Astro's `base`.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stats = [
  { value: '3–8', label: "the classes where CBSE now builds Computational Thinking & AI into regular subjects from session 2026-27 — every student, not an opt-in choice" },
  { value: '417', label: "CBSE's optional AI Skill Subject code for Grades 9–10 — schools that offer it still need someone who can deliver it" },
];
---
<section data-beat="blank" class="bg-surface">
  <div class="max-w-content mx-auto px-gutter py-section">
    <h2 class="font-display text-h2 font-bold text-fg text-center">AI is arriving in Indian classrooms from Class 3 — most students still aren't taught how it works</h2>
    <p class="mx-auto mt-4 max-w-prose text-center text-fg-muted">
      From session 2026-27, CBSE has introduced Computational Thinking &amp; AI as an integrated part of the curriculum for Classes 3 to 8 — built into subjects every student already takes rather than offered as a choice. Other boards are moving in the same direction. Ages 10 to 15 spans roughly Classes 5 to 10, which puts this program right on that cohort.
    </p>
    <div class="mx-auto mt-stack grid max-w-3xl gap-grid sm:grid-cols-2">
      {stats.map((s) => (
        <div class="rounded-2xl border border-line bg-surface-raised p-6 text-center shadow-sm transition-shadow hover:shadow-md">
          <div class="font-display text-h1 font-bold text-accent">{s.value}</div>
          <p class="mt-2 text-small text-fg-muted">{s.label}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 text-center text-small">
      <a href={`${base}/about/`} class="font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 transition-colors hover:text-accent-strong">
        Why this is happening now
      </a>
    </p>
  </div>
</section>
