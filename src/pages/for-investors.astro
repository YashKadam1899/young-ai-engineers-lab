---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAILS, mailto } from '../emails';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const traction = [
  { title: 'Instructor secured', body: 'IIT Bombay alumnus & AI specialist committed as founding co-instructor.' },
  // tall: spans both rows of the right column, so the two short cards stack
  // beside it instead of leaving a gap under the first one.
  { title: 'Curriculum locked', tall: true, body: "12-session, 6-week 'Winter Lab' main program — beginner, intermediate and practitioner tiers — plus a selective, invitation-only 8-session expert stage for capstone builds, entered from the main program rather than sold separately." },
  { title: 'Founding batch open', body: 'Open and filling with zero paid ad spend.' },
];
---
<BaseLayout
  beat="investor"
  title="For Investors: Pre-Seed Overview · Young AI Engineers Lab"
  description="We're raising a pre-seed round: how one founding Winter Lab cohort de-risks a school AI delivery business, as AI enters Indian classrooms from Class 3."
>
  <section class="max-w-narrow mx-auto px-gutter py-section">
    <h1 class="font-display text-h1 font-bold text-fg">We're raising a pre-seed round</h1>
    <p class="mt-2 max-w-prose text-fg-muted">
      We're proving the model works with one strong paying cohort — before we pitch a single school.
    </p>
    <p class="mt-2 max-w-prose text-fg-muted">
      From session 2026-27, CBSE has introduced Computational Thinking &amp; AI as an integrated part of the curriculum for Classes 3 to 8, with higher classes following — taught inside subjects every student already takes, so it reaches the whole cohort rather than an opt-in few. Other boards are moving in the same direction. Our 10–15 age range spans roughly Classes 5 to 10, which puts the product directly on that curriculum-integrated cohort instead of resting on an elective. Schools now need delivery partners, not just textbooks. That gap is the opportunity.
    </p>
    <div class="mt-stack grid gap-grid sm:grid-cols-2">
      {traction.map((t) => (
        <div class:list={['rounded-2xl border border-line bg-surface-raised p-5 shadow-sm transition-shadow hover:shadow-md', t.tall && 'sm:col-start-2 sm:row-span-2 sm:row-start-1']}>
          <h2 class="font-display text-h3 font-semibold text-fg">{t.title}</h2>
          <p class="mt-1 text-small text-fg-muted">{t.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 text-small text-fg-muted">
      Product detail: <a href={`${base}/#how-it-works`} class="font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 hover:text-accent-strong">how the Winter Lab runs</a> and <a href={`${base}/our-team/`} class="font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 hover:text-accent-strong">who teaches it</a>.
    </p>
    <div class="mt-stack text-center">
      <a
        href={mailto(EMAILS.invest, 'Investor deck request')}
        class="inline-block rounded-full bg-cta px-6 py-3.5 text-cta-fg font-semibold shadow-lg shadow-cta/25 transition-all hover:-translate-y-0.5 hover:bg-cta-hover hover:shadow-xl hover:shadow-cta/30"
      >
        Request the full deck
      </a>
      <p class="mt-3 text-small text-fg-subtle">Or write to {EMAILS.invest} directly.</p>
    </div>
  </section>
</BaseLayout>
