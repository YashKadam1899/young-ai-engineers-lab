---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAILS, mailto } from '../emails';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const traction = [
  { title: 'Instructor secured', body: 'IIT Bombay alumnus & AI specialist committed as founding co-instructor.' },
  { title: 'Curriculum locked', body: "12-session, 6-week 'Winter Lab' main program — beginner, intermediate and practitioner tiers — plus a selective 8-session expert stage for capstone builds." },
  { title: 'Founding batch open', body: 'Open and filling with zero paid ad spend.' },
  { title: 'Demo Day → proof', body: 'Parent-attended capstone showcase becomes the case-study asset for our first school pitches.' },
];
---
<BaseLayout
  title="For Investors: Pre-Seed Overview · Young AI Engineers Lab"
  description="We're raising a pre-seed round. How a founding Winter Lab cohort de-risks a CBSE Code 417 delivery business — and how to request the full deck."
>
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="font-display text-3xl font-bold text-ink-950 sm:text-4xl">We're raising a pre-seed round</h1>
    <p class="mt-2 text-ink-600">
      We're proving the model works with one strong paying cohort — before we pitch a single school.
    </p>
    <p class="mt-2 text-ink-600">
      CBSE has made Artificial Intelligence a board-recognised Skill Subject for Grades 9–10 (Code 417), and introduced a Computational Thinking &amp; AI curriculum for Classes 3–8 from session 2026-27. Schools now need delivery partners, not just textbooks. That gap is the opportunity.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {traction.map((t) => (
        <div class="rounded-2xl border border-indigo-100 bg-cream-50 p-5 shadow-sm transition-shadow hover:shadow-md">
          <h2 class="font-display font-semibold text-ink-950">{t.title}</h2>
          <p class="mt-1 text-sm text-ink-600">{t.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 text-sm text-ink-600">
      Product detail: <a href={`${base}/#how-it-works`} class="font-semibold text-indigo-600 underline decoration-coral-300 decoration-2 underline-offset-4 hover:text-indigo-700">how the Winter Lab runs</a> and <a href={`${base}/our-team/`} class="font-semibold text-indigo-600 underline decoration-coral-300 decoration-2 underline-offset-4 hover:text-indigo-700">who teaches it</a>.
    </p>
    <div class="mt-10 text-center">
      <a
        href={mailto(EMAILS.invest, 'Investor deck request')}
        class="inline-block rounded-full bg-coral-500 px-6 py-3.5 text-white font-semibold shadow-lg shadow-coral-500/25 transition-all hover:-translate-y-0.5 hover:bg-coral-600 hover:shadow-xl hover:shadow-coral-500/30"
      >
        Request the full deck
      </a>
      <p class="mt-3 text-sm text-ink-400">Or write to {EMAILS.invest} directly.</p>
    </div>
  </section>
</BaseLayout>
