---
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqHubFlat, faqHubGroups } from '../content/faq-hub';
import { absoluteUrl, breadcrumbListSchema, faqPageSchema } from '../seo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = absoluteUrl(Astro.site, 'faq/');
const homeUrl = absoluteUrl(Astro.site);

const schema = [
  faqPageSchema(faqHubFlat),
  breadcrumbListSchema([
    { name: 'Home', url: homeUrl },
    { name: 'FAQ', url: pageUrl },
  ]),
];
---
<BaseLayout
  beat="calm"
  title="FAQ: AI Course for Ages 10–15 · Young AI Engineers Lab"
  description="FAQ for parents and schools: live online parent-sponsored cohorts for ages 10–15 in India, on-campus seminars, English instruction, how to enquire."
  schema={schema}
>
  <section class="max-w-narrow mx-auto px-gutter py-section">
    <h1 class="font-display text-h1 font-bold text-fg">Questions about the live online and on-campus AI lab</h1>
    <p class="mt-3 max-w-prose text-fg-muted">
      Parent-sponsored cohorts join live online; schools book free on-campus seminars and labs. Grouped answers below. For the short list on the homepage, see <a href={`${base}/#faq`} class="font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 hover:text-accent-strong">Questions parents ask us first</a>.
    </p>

    <div class="mt-stack space-y-10">
      {faqHubGroups.map((group) => (
        <div>
          <h2 class="font-display text-h3 font-semibold text-fg">{group.heading}</h2>
          <div class="mt-4 space-y-3">
            {group.items.map((f) => (
              <details class="group rounded-2xl border border-line bg-surface-raised shadow-sm transition-shadow hover:shadow-md">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-2xl p-5 group-open:pb-3">
                  <span class="font-display font-semibold text-fg">{f.q}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-accent transition-transform duration-200 group-open:rotate-45 motion-reduce:transition-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
                  </svg>
                </summary>
                <div class="px-5 pb-5">
                  <p class="text-small text-fg-muted">
                    {f.inlineLink && f.a.includes(f.inlineLink.phrase) ? (
                      <>
                        {f.a.slice(0, f.a.indexOf(f.inlineLink.phrase))}
                        <a
                          href={f.inlineLink.href}
                          target={f.inlineLink.external ? '_blank' : undefined}
                          rel={f.inlineLink.external ? 'noopener noreferrer' : undefined}
                          class="font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 transition-colors hover:text-accent-strong"
                        >
                          {f.inlineLink.phrase}
                          {f.inlineLink.external && <span class="sr-only"> (opens in a new tab)</span>}
                        </a>
                        {f.a.slice(f.a.indexOf(f.inlineLink.phrase) + f.inlineLink.phrase.length)}
                      </>
                    ) : (
                      f.a
                    )}
                  </p>
                  {f.cta && (
                    <a href={f.cta.href} class="mt-3 inline-block wrap-anywhere text-small font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 transition-colors hover:text-accent-strong">
                      {f.cta.label}
                    </a>
                  )}
                  {f.more && (
                    <a href={f.more.href} class="mt-3 ml-0 block text-small font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 transition-colors hover:text-accent-strong sm:ml-0">
                      {f.more.label}
                    </a>
                  )}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="mt-stack text-small text-fg-muted">
      Still stuck? <a href={`${base}/contact/`} class="font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 hover:text-accent-strong">Contact us</a>, or see <a href={`${base}/#how-it-works`} class="font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 hover:text-accent-strong">how the Winter Lab runs</a>.
    </p>
  </section>
</BaseLayout>
