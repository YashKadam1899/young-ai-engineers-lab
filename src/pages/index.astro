---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAILS, mailto } from '../emails';
import { courseSchema, faqPageSchema } from '../seo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stats = [
  { value: '3–8', label: "the classes where CBSE now builds Computational Thinking & AI into regular subjects from session 2026-27 — every student, not an opt-in choice" },
  { value: '250M+', label: 'school students in India, Grades 6–12 (government and private, estimated)' },
  { value: '417', label: "CBSE's optional AI Skill Subject code for Grades 9–10 — schools that offer it still need someone who can deliver it" },
  { value: '<5%', label: "of India's computer-science and IT teachers feel confident teaching AI concepts (estimated, pilot interviews)" },
];

const pillars = [
  { title: 'Foundations', body: "What AI actually is — and isn't — and how machine learning is different from simple rule-following. Explained through apps you already use: UPI payments, weather forecasts and photo search." },
  { title: 'Computational Thinking', body: "Breaking a big problem into small steps, spotting patterns, and ignoring what doesn't matter — the same thinking that helps with exams and with solving everyday problems." },
  { title: 'Hands-On Creation', body: "Writing prompts that get AI to do what you want, building an app that recognizes images, and creating an AI helper with no coding required." },
  { title: 'Ethics & Evaluation', body: "Testing AI for unfair bias, learning to catch AI when it makes things up, spotting deepfakes, and seeing what real AI careers look like." },
];

const tiers = [
  {
    step: '1',
    title: 'Beginner',
    meta: '4 sessions',
    body: "How AI actually works and where it came from, the types of AI, chatbots versus purpose-built AI tools, the buzzwords decoded — and where your data really goes when you use a chatbot.",
  },
  {
    step: '2',
    title: 'Intermediate',
    meta: '4 sessions',
    body: "How today's AI tools are built on large language models, why two models answer the same question differently, what prompts, context, tokens and parameters actually are, the basics of AI governance, what is safe to share with an AI tool, and where AI image generation breaks down.",
  },
  {
    step: '3',
    title: 'Practitioner',
    meta: '4 sessions',
    body: 'Prompt engineering as a craft, keeping a long conversation on track, spotting and fact-checking AI hallucinations — and a lot of hands-on practice.',
  },
];

const differentiators = [
  {
    title: 'A lab companion to the syllabus, not a weekend add-on',
    usually: 'AI for school students is usually sold as an extracurricular luxury, bolted on after school hours.',
    ours: "We're built to sit alongside the syllabus a school already runs — reinforcing the timetable rather than competing with it.",
  },
  {
    title: 'Depth on the two skills that decide everything',
    usually: "Prompt engineering isn't a named unit in most school syllabi, and neither is checking an AI's output for things it made up.",
    ours: 'Both get dedicated sessions here: how to instruct a model precisely, and how to catch it when it is confidently wrong. These are the skills a student uses every single day.',
  },
  {
    title: 'Every module ends in something they built',
    usually: 'Short AI courses tend to end in a slide deck, a quiz score, or a certificate of attendance.',
    ours: 'Students finish with working prompts, hands-on exercises, and their own tests of where a model breaks down — recorded in a portfolio someone else can actually open and check.',
  },
];

const faqs = [
  {
    q: 'Who is this for?',
    a: "Students aged 10 to 15 — roughly Grades 5 to 10, across CBSE, ICSE and state boards. The three tiers of the main program scale with age, so a 10-year-old and a 15-year-old meet the same ideas at different depths rather than sitting through the same material. It's the range where AI tools are already part of daily life, and where schools are starting to teach AI inside regular subjects.",
  },
  {
    q: 'Does my child need to know how to code?',
    a: 'No prior coding required. We start from what AI is and what it is not, and the building happens through prompts, image classifiers and no-code tools. Curiosity matters more here than any head start in programming.',
  },
  {
    q: 'What language is it taught in?',
    a: 'English. All sessions, materials and exercises are in English.',
  },
  {
    q: 'Why now?',
    a: "Government policy, the new CBSE syllabus, and growing parent concern are all lining up in the same two years. The clearest signal: from session 2026-27, Computational Thinking & AI is an integrated part of CBSE's curriculum for Classes 3 to 8 — taught inside subjects every student already takes, rather than offered as a choice. Meanwhile students already have AI in their pocket, and most teachers have had no hands-on, project-based training to work with.",
    more: { href: `${base}/about/`, label: 'Read our mission, vision and goal' },
  },
  {
    q: 'How does this relate to what school already teaches? Does it replace it?',
    a: "It supplements school — it replaces nothing. For CBSE schools specifically: Computational Thinking & AI is integrated into Classes 3 to 8 for every student, and Artificial Intelligence (Code 417) is an optional but substantial Skill Subject in Grades 9 and 10. Other boards are moving in the same direction at their own pace. We're designed as a lab companion either way: a short, project-dense block that gives students reps on building and questioning AI systems.",
  },
  {
    q: 'What is the Student AI Portfolio, and why does it matter?',
    a: "It's a public, verifiable record of what your child actually built, rather than a private folder of files. Some school syllabi already ask students to keep a portfolio of their AI activities — CBSE's Code 417 does, for Grades 9 and 10. Ours is built to be opened and checked by someone else: the kind of evidence that holds up on a college or hackathon application.",
  },
  {
    q: 'What will my child actually build?',
    a: 'Modules end in something real rather than a quiz — working prompts, hands-on exercises with AI tools, and their own tests of where a model breaks down. Students later invited into the selective Expert tier go on to build one full capstone — a chatbot, an image classifier, or a bias audit — and present it at a parent-attended Demo Day. That invitation comes from inside the main program, so there is nothing separate to sign up for.',
    more: { href: `${base}/#how-it-works`, label: 'See how the two stages run' },
  },
  {
    q: 'What does it cost, and when does the next cohort start?',
    a: 'The founding Winter Lab cohort is open now. Email us and we will send you the current dates and fees, with no obligation.',
    cta: { href: mailto(EMAILS.learn, 'Winter Lab — dates and fees'), label: `Email ${EMAILS.learn}` },
  },
  {
    q: 'How do schools bring this to their students?',
    a: "We work as a delivery partner to schools across CBSE, ICSE and state boards — curriculum packs, teacher enablement, and a moderated student sandbox that fit into a school's existing computer lab or Atal Tinkering Lab. Funded implementations for government and rural schools are possible through CSR and state partnerships.",
    cta: { href: mailto(EMAILS.partner, 'School partnership enquiry'), label: `Email ${EMAILS.partner}` },
  },
];

// FAQ schema is built from the same `faqs` array rendered below, so the
// structured data always matches the visible Q&A exactly.
const schema = [courseSchema(Astro.site), faqPageSchema(faqs)];
---
<BaseLayout
  title="AI Course for Ages 10–15 in India | Young AI Engineers Lab"
  ogTitle="Turning India's 10–15 year-olds from AI consumers into AI developers"
  description="A live online AI lab for 10–15 year-olds in India: 12 sessions over 6 weeks, taught in English, alongside what schools are now starting to teach about AI."
  schema={schema}
>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 h-72 w-72 rounded-full bg-indigo-200/50 blur-3xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-10 right-0 h-80 w-80 rounded-full bg-coral-200/40 blur-3xl"></div>
    <div class="relative max-w-5xl mx-auto px-4 py-20 sm:py-28 text-center">
      <h1 class="font-display text-4xl font-bold tracking-tight text-ink-950 sm:text-6xl">
        Turning India's 10–15 year-olds from AI consumers into AI developers
      </h1>
      <div class="mt-9 flex flex-col sm:flex-row justify-center gap-4">
        <a href={mailto(EMAILS.learn, 'Winter Batch signup')} class="rounded-full bg-coral-500 px-6 py-3.5 text-white font-semibold shadow-lg shadow-coral-500/25 transition-all hover:-translate-y-0.5 hover:bg-coral-600 hover:shadow-xl hover:shadow-coral-500/30">Sign Up for the Winter Batch</a>
        <a href={`${base}/for-investors/`} class="rounded-full border-2 border-indigo-200 bg-cream-50 px-6 py-3.5 text-ink-800 font-semibold transition-all hover:-translate-y-0.5 hover:border-indigo-400 hover:bg-indigo-50">See the Investor Overview</a>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="font-display text-2xl font-bold text-ink-950 text-center sm:text-3xl">AI is arriving in Indian classrooms from Class 3 — most students still aren't taught how it works</h2>
    <p class="mx-auto mt-4 max-w-3xl text-center text-ink-600">
      From session 2026-27, CBSE has introduced Computational Thinking &amp; AI as an integrated part of the curriculum for Classes 3 to 8 — built into subjects every student already takes rather than offered as a choice. Other boards are moving in the same direction. Ages 10 to 15 spans roughly Classes 5 to 10, which puts this program right on that cohort.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {stats.map((s) => (
        <div class="rounded-2xl border border-indigo-100 bg-cream-50 p-6 text-center shadow-sm transition-shadow hover:shadow-md">
          <div class="font-display text-3xl font-bold text-indigo-600">{s.value}</div>
          <p class="mt-2 text-sm text-ink-600">{s.label}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 text-center text-ink-600 italic">
      Urban private-school families already pay ₹5,000–₹15,000 for the few programs that try to fill this gap.
    </p>
    <p class="mt-4 text-center text-sm">
      <a href={`${base}/about/`} class="font-semibold text-indigo-600 underline decoration-coral-300 decoration-2 underline-offset-4 transition-colors hover:text-indigo-700">
        Why this is happening now
      </a>
    </p>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="font-display text-2xl font-bold text-ink-950 text-center sm:text-3xl">Four modules, one goal: build with AI, not just talk about it</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map((p) => (
        <div class="rounded-2xl bg-ink-950 text-white p-6 border-t-4 border-indigo-400 shadow-md transition-transform hover:-translate-y-1">
          <h3 class="font-display font-semibold text-lg">{p.title}</h3>
          <p class="mt-2 text-sm text-ink-100/80">{p.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-center text-ink-600 italic">
      Every module ends with something the student has actually made, not a quiz score — and that work is saved to a public Student AI Portfolio colleges and employers can open and check for themselves.
    </p>
  </section>

  <section id="how-it-works" class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="font-display text-2xl font-bold text-ink-950 text-center sm:text-3xl">How the Winter Lab actually runs</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-ink-600">
      The founding cohort is open now. It runs in two stages — live and online, so a student can join from any city.
    </p>

    <div class="mt-8 flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-3">
      <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600">Stage 1 · Main program</p>
      <p class="text-sm text-ink-600">12 live sessions over 6 weeks, in three tiers of four.</p>
    </div>
    <ol class="mt-4 grid gap-6 md:grid-cols-3">
      {tiers.map((item) => (
        <li class="rounded-2xl border border-indigo-100 bg-cream-50 p-6 shadow-sm transition-shadow hover:shadow-md">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-indigo-600 font-display font-bold text-white">{item.step}</span>
          <h3 class="mt-4 font-display font-semibold text-ink-950">{item.title}</h3>
          <p class="text-xs font-semibold uppercase tracking-wider text-ink-400">{item.meta}</p>
          <p class="mt-2 text-sm text-ink-600">{item.body}</p>
        </li>
      ))}
    </ol>

    <div class="mt-8 rounded-2xl border-2 border-dashed border-coral-200 bg-coral-50 p-6 sm:p-8">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-3">
        <p class="text-xs font-semibold uppercase tracking-wider text-coral-700">Stage 2 · Expert tier</p>
        <p class="text-sm text-ink-600">A separate 8-session stage, by invitation only.</p>
      </div>
      <h3 class="mt-3 font-display text-xl font-bold text-ink-950">The capstone stage, earned by the students who go furthest</h3>
      <p class="mt-2 text-sm text-ink-600">
        After the main program, a select few students — the ones who show the strongest potential across the three tiers — are invited into eight further sessions built around one real capstone: a chatbot, an image classifier, or a bias audit of their own. It ends with a presentation at a parent-attended Demo Day and a published entry in their Student AI Portfolio.
      </p>
      <p class="mt-2 text-sm font-medium text-ink-600">
        There is nothing to register for here. Every student starts with the 12-session main program, and invitations to the Expert tier are made from inside it — so this is an earned next step, not an automatic one. The main program stands complete on its own: every student who finishes it has built real work and learned to question it.
      </p>
    </div>

    <div class="mt-8 text-center">
      <a
        href={mailto(EMAILS.learn, 'Winter Lab — dates and fees')}
        class="inline-block rounded-full bg-coral-500 px-6 py-3.5 text-white font-semibold shadow-lg shadow-coral-500/25 transition-all hover:-translate-y-0.5 hover:bg-coral-600 hover:shadow-xl hover:shadow-coral-500/30"
      >
        Ask about dates and fees
      </a>
      <p class="mt-3 text-sm text-ink-400">Signing up is for Stage 1, the 12-session main program. Writes to {EMAILS.learn} — a real person replies.</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="font-display text-2xl font-bold text-ink-950 text-center sm:text-3xl">What makes this different</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-ink-600">
      Plenty of short AI and coding programs are already on offer. Three things about ours are deliberately not the same.
    </p>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {differentiators.map((d) => (
        <div class="flex flex-col rounded-2xl border border-indigo-100 bg-cream-50 p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md">
          <h3 class="font-display font-semibold text-lg text-ink-950">{d.title}</h3>
          <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-ink-400">Usually</p>
          <p class="mt-1 text-sm text-ink-400">{d.usually}</p>
          <div class="my-4 h-px bg-indigo-100"></div>
          <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600">Here</p>
          <p class="mt-1 text-sm text-ink-600">{d.ours}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-ink-950 text-white">
    <div class="max-w-5xl mx-auto px-4 py-16">
      <div class="grid items-center gap-8 md:grid-cols-5">
        <div class="md:col-span-3">
          <p class="text-xs font-semibold uppercase tracking-wider text-indigo-300">Who teaches it</p>
          <h2 class="mt-3 font-display text-2xl font-bold sm:text-3xl">An IIT Bombay alumnus joining as instructor for each session</h2>
          <p class="mt-4 text-ink-100/80">
            Our co-founder and Head of Curriculum is an IIT Bombay alumnus and a working AI/ML practitioner — and he is in the room for every single session, not just the first one. No recorded video course, and no script read out by a part-time tutor: your child is learning from someone who builds AI systems for a living.
          </p>
          <a href={`${base}/our-team/`} class="mt-6 inline-block rounded-full border-2 border-indigo-400 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-indigo-600">
            Meet the team
          </a>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/5 p-6 md:col-span-2">
          <p class="font-display text-lg font-semibold">The founding cohort is the proof</p>
          <p class="mt-2 text-sm text-ink-100/70">
            We're deliberately running one strong cohort — taught by the founders, ending in a parent-attended Demo Day — before we pitch a single school. The students' work is the case study.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12">
    <div class="rounded-2xl border border-indigo-100 bg-cream-50 p-6 shadow-sm sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-wider text-indigo-600">For schools, CSR and state partners</p>
      <h2 class="mt-3 font-display text-2xl font-bold text-ink-950">A delivery partner for your AI curriculum</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="font-display font-semibold text-ink-950">Schools</h3>
          <p class="mt-1 text-sm text-ink-600">
            Curriculum packs, teacher enablement, and a moderated student sandbox that fit inside your existing computer lab or Atal Tinkering Lab — so AI is taught in the timetable, not outsourced to a weekend workshop.
          </p>
        </div>
        <div>
          <h3 class="font-display font-semibold text-ink-950">CSR &amp; state partners</h3>
          <p class="mt-1 text-sm text-ink-600">
            Fully funded implementations are possible for government and rural schools — including Navodaya and Kendriya Vidyalaya-type networks — through corporate CSR budgets and state programmes.
          </p>
        </div>
      </div>
      <div class="mt-7 flex flex-col gap-3 sm:flex-row">
        <a
          href={mailto(EMAILS.partner, 'School partnership enquiry')}
          class="rounded-full bg-indigo-600 px-5 py-3 text-center text-sm font-semibold text-white transition-colors hover:bg-indigo-700"
        >
          Talk to us about a school partnership
        </a>
        <a
          href={mailto(EMAILS.partner, 'CSR or state partnership enquiry')}
          class="rounded-full border-2 border-indigo-200 px-5 py-3 text-center text-sm font-semibold text-ink-800 transition-colors hover:border-indigo-400 hover:bg-indigo-50"
        >
          Discuss a funded implementation
        </a>
      </div>
      <p class="mt-3 text-sm text-ink-400">Both reach {EMAILS.partner}.</p>
    </div>
  </section>

  <section id="faq" class="max-w-3xl mx-auto px-4 py-12">
    <h2 class="font-display text-2xl font-bold text-ink-950 text-center sm:text-3xl">Questions parents ask us first</h2>
    <div class="mt-8 space-y-3">
      {faqs.map((f) => (
        <details class="group rounded-2xl border border-indigo-100 bg-cream-50 p-5 shadow-sm transition-shadow hover:shadow-md">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4">
            <span class="font-display font-semibold text-ink-950">{f.q}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 text-indigo-600 transition-transform duration-200 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14M5 12h14" />
            </svg>
          </summary>
          <p class="mt-3 text-sm text-ink-600">{f.a}</p>
          {f.cta && (
            <a href={f.cta.href} class="mt-3 inline-block text-sm font-semibold text-indigo-600 underline decoration-coral-300 decoration-2 underline-offset-4 transition-colors hover:text-indigo-700">
              {f.cta.label}
            </a>
          )}
          {f.more && (
            <a href={f.more.href} class="mt-3 inline-block text-sm font-semibold text-indigo-600 underline decoration-coral-300 decoration-2 underline-offset-4 transition-colors hover:text-indigo-700">
              {f.more.label}
            </a>
          )}
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 pb-16 pt-4">
    <div class="relative overflow-hidden rounded-2xl bg-ink-950 px-6 py-14 text-center text-white sm:px-10">
      <div aria-hidden="true" class="pointer-events-none absolute -top-16 -right-10 h-56 w-56 rounded-full bg-indigo-500/30 blur-3xl"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -left-10 h-56 w-56 rounded-full bg-coral-500/20 blur-3xl"></div>
      <div class="relative">
        <h2 class="font-display text-2xl font-bold sm:text-3xl">Sign up for the Winter Batch</h2>
        <p class="mx-auto mt-4 max-w-2xl text-ink-100/80">
          The founding batch of the Winter Lab is open right now — the 12-session main program, run over 6 weeks. Your child is already using AI — this is where they learn to build with it. Send one email and we will reply with the dates, the fees and exactly what your child will build.
        </p>
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={mailto(EMAILS.learn, 'Winter Batch signup')}
            class="w-full rounded-full bg-coral-500 px-6 py-3.5 font-semibold text-white shadow-lg shadow-coral-500/25 transition-all hover:-translate-y-0.5 hover:bg-coral-600 sm:w-auto"
          >
            Sign up for the Winter Batch
          </a>
          <a
            href={`${base}/contact/`}
            class="w-full rounded-full border-2 border-white/25 px-6 py-3.5 font-semibold text-white transition-colors hover:border-white/60 hover:bg-white/10 sm:w-auto"
          >
            Other ways to reach us
          </a>
        </div>
        <p class="mt-6 text-sm text-ink-100/60">
          Schools, CSR and state partners: <a href={mailto(EMAILS.partner, 'School or CSR partnership enquiry')} class="font-semibold text-indigo-200 underline underline-offset-4 hover:text-white">{EMAILS.partner}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
