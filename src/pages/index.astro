---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const stats = [
  { value: '250M+', label: 'students in Grades 6–12 across India (govt. + private, est.)' },
  { value: '417', label: "CBSE's new mandatory AI subject code — but almost no trained teachers to deliver it" },
  { value: '<5%', label: 'of CS/IT teachers report feeling confident teaching AI concepts (est.)' },
];

const pillars = [
  { title: 'Foundations', body: "What AI is/isn't, ML vs. rules, everyday examples from UPI, weather apps & Bhashini translation." },
  { title: 'Computational Thinking', body: 'Decomposition, patterns & abstraction — applied to exam prep and local problem-solving.' },
  { title: 'Hands-On Creation', body: 'Prompt engineering, image classifiers & no-code agents, built in Hindi/regional languages.' },
  { title: 'Ethics & Evaluation', body: 'Bias audits, hallucination-spotting, deepfake literacy, and career pathway exposure.' },
];
---
<BaseLayout title="Home">
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 h-72 w-72 rounded-full bg-indigo-200/50 blur-3xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -top-10 right-0 h-80 w-80 rounded-full bg-coral-200/40 blur-3xl"></div>
    <div class="relative max-w-5xl mx-auto px-4 py-20 sm:py-28 text-center">
      <h1 class="font-display text-4xl font-bold tracking-tight text-ink-950 sm:text-6xl">
        Turning India's 13–15 year-olds from AI consumers into AI creators
      </h1>
      <p class="mt-5 text-lg text-ink-600 sm:text-xl">
        Built for CBSE classrooms, priced for every pin code.
      </p>
      <div class="mt-9 flex flex-col sm:flex-row justify-center gap-4">
        <a href={`${base}/contact`} class="rounded-full bg-coral-500 px-6 py-3.5 text-white font-semibold shadow-lg shadow-coral-500/25 transition-all hover:-translate-y-0.5 hover:bg-coral-600 hover:shadow-xl hover:shadow-coral-500/30">Contact Us</a>
        <a href={`${base}/for-investors`} class="rounded-full border-2 border-indigo-200 bg-cream-50 px-6 py-3.5 text-ink-800 font-semibold transition-all hover:-translate-y-0.5 hover:border-indigo-400 hover:bg-indigo-50">For Investors</a>
      </div>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12 grid gap-6 sm:grid-cols-3">
    {stats.map((s) => (
      <div class="rounded-2xl border border-indigo-100 bg-cream-50 p-6 text-center shadow-sm transition-shadow hover:shadow-md">
        <div class="font-display text-3xl font-bold text-indigo-600">{s.value}</div>
        <p class="mt-2 text-sm text-ink-600">{s.label}</p>
      </div>
    ))}
  </section>

  <section class="max-w-5xl mx-auto px-4 py-12">
    <h2 class="font-display text-2xl font-bold text-ink-950 text-center sm:text-3xl">A four-pillar, project-first AI curriculum</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {pillars.map((p) => (
        <div class="rounded-2xl bg-ink-950 text-white p-6 border-t-4 border-indigo-400 shadow-md transition-transform hover:-translate-y-1">
          <h3 class="font-display font-semibold text-lg">{p.title}</h3>
          <p class="mt-2 text-sm text-ink-100/80">{p.body}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 text-center text-ink-600 italic">
      Every module ends in a tangible artifact — a chatbot, a plant classifier, a bias audit — added to a public, verifiable Student AI Portfolio.
    </p>
  </section>
</BaseLayout>
