---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pillars = [
  {
    label: 'Mission',
    title: 'Teach students to build with AI, not just use it',
    body: "Every 10–15 year-old in India already has AI in their pocket. Almost none of them have been taught how it works, where it fails, or how to make something with it. We run short, project-dense programs that close that gap — taught live, by people who build AI professionally.",
  },
  {
    label: 'Vision',
    title: 'A generation that can explain AI, build with it, and question it',
    body: "In three years, thousands of Indian school students — a meaningful share of them from government and rural schools — will be able to explain how AI works, build something useful with it, and question it critically. Not a coding camp. Not a certificate mill. Infrastructure for a generation that will be judged on whether it can create with AI rather than only consume it.",
  },
  {
    label: 'Goal',
    title: 'Every student finishes with something they built',
    body: "No student leaves with only a certificate. Each one finishes with working prompts, hands-on exercises, and their own tests of where a model breaks down — recorded in a portfolio someone else can open and check. Our near-term goal is to prove that on one strong cohort, then make it repeatable.",
  },
];

// Problems and responses are deliberately parallel: problem N is answered by
// response N, and the numbering on the page makes that mapping visible.
const problems = [
  {
    title: 'Students already have it',
    body: 'Students already have ChatGPT in their pocket. Most reach for it to finish homework rather than to understand how it works. Parents want to know their children are learning from it safely — not quietly outsourcing their thinking to it.',
  },
  {
    title: 'It is no longer optional',
    body: 'From session 2026-27, Computational Thinking & AI sits inside subjects every student in Classes 3 to 8 already takes. There is no opting out and no separate elective to choose. Ages 10 to 15 spans roughly Classes 5 to 10 — the same cohort now meeting AI in its regular timetable.',
  },
  {
    title: 'The senior syllabus is substantial',
    body: 'In Grades 9 and 10, Artificial Intelligence remains a board-recognised optional Skill Subject — practical and demanding, at 210 hours per year. A school can only offer it if someone there can actually deliver it.',
  },
  {
    title: 'Teachers were not trained for this',
    body: 'Teacher-training programmes exist on paper. What is missing is hands-on, project-based material a teacher can pick up and use in a real classroom on Monday morning.',
  },
];

const responses = [
  {
    title: 'Start from the tool they already use',
    body: 'We begin with the chatbot in their hand: what it is doing, why it sounds confident when it is wrong, and what should never be typed into it. Curiosity about a tool they already have beats a syllabus they have no reason to care about.',
  },
  {
    title: 'Reinforce what school teaches',
    body: 'Live online sessions over 6 weeks, designed to reinforce what the school already teaches rather than compete with it.',
  },
  {
    title: 'Build it hands-on, live online',
    body: 'A live online, project-based lab where students learn by making things with AI, not by reading about it.',
  },
  {
    title: 'Leave evidence behind',
    body: 'Every module ends in something the student made and can show — collected in a public, verifiable portfolio. That is the proof a school, a parent and a college admissions reader can each check for themselves.',
  },
];
---
<BaseLayout
  beat="calm"
  title="About Us: Mission, Vision and Goal · Young AI Engineers Lab"
  description="Our mission, vision and goal — and the problem we exist to solve: AI arrived in Indian classrooms faster than anyone could be trained to teach it."
>
  <section class="max-w-content mx-auto px-gutter py-section">
    <h1 class="font-display text-h1 font-bold text-fg">What we're building, and why</h1>
    <p class="mt-2 max-w-prose text-fg-muted">
      AI is arriving in Indian classrooms faster than teachers can be trained for it. We exist to make sure the next generation can build with AI and challenge it — not just ask it for answers.
    </p>

    <div class="mt-stack grid gap-grid sm:grid-cols-3" data-reveal-stagger>
      {pillars.map((p) => (
        <div class="rounded-2xl border border-line bg-surface-raised p-6 shadow-sm transition-shadow hover:shadow-md">
          <span class="text-xs font-semibold uppercase tracking-wider text-accent">{p.label}</span>
          <h2 class="mt-2 font-display text-h3 font-semibold text-fg">{p.title}</h2>
          <p class="mt-2 text-small text-fg-muted">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- The problem — dark band, so the gap reads as weight rather than decoration -->
  <section class="bg-surface-inverse text-white">
    <div class="max-w-content mx-auto px-gutter py-section">
      <span class="text-xs font-semibold uppercase tracking-wider text-accent-warm">The problem</span>
      <h2 class="mt-3 font-display text-h2 font-bold">
        AI arrived in Indian classrooms faster than anyone could be trained to teach it
      </h2>
      <div class="mt-stack grid gap-grid sm:grid-cols-2" data-reveal-stagger>
        {problems.map((p, i) => (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
            <span class="font-display text-small font-bold text-accent-warm">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-2 font-display text-h3 font-semibold text-white">{p.title}</h3>
            <p class="mt-2 text-small text-fg-inverse/75">{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The response — same numbering, so the 1:1 mapping is legible without labels -->
  <section class="max-w-content mx-auto px-gutter py-section">
    <span class="text-xs font-semibold uppercase tracking-wider text-accent">Our solution</span>
    <h2 class="mt-3 font-display text-h2 font-bold text-fg">
      A short, project-dense program that answers each of those directly
    </h2>
    <p class="mt-3 max-w-prose text-fg-muted">
      Each point below answers the problem with the same number above it.
    </p>
    <div class="mt-stack grid gap-grid sm:grid-cols-2" data-reveal-stagger>
      {responses.map((r, i) => (
        <div class="rounded-2xl border border-line bg-surface-raised p-6 shadow-sm transition-shadow hover:shadow-md">
          <span class="font-display text-small font-bold text-accent">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="mt-2 font-display text-h3 font-semibold text-fg">{r.title}</h3>
          <p class="mt-2 text-small text-fg-muted">{r.body}</p>
        </div>
      ))}
    </div>

    <div class="mt-stack flex flex-col gap-3 sm:flex-row">
      <a href={`${base}/#how-it-works`} class="rounded-full bg-cta px-5 py-2.5 text-center text-small font-semibold text-cta-fg shadow-lg shadow-cta/25 transition-all hover:-translate-y-0.5 hover:bg-cta-hover">
        See how the Winter Lab runs
      </a>
      <a href={`${base}/our-team/`} class="rounded-full border-2 border-line-medium px-5 py-2.5 text-center text-small font-semibold text-fg-secondary transition-all hover:-translate-y-0.5 hover:border-line-strong hover:bg-surface-tint">
        Meet the team
      </a>
    </div>
  </section>
</BaseLayout>
