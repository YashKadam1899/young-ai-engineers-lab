---
import BaseLayout from '../layouts/BaseLayout.astro';

const whyNow = [
  { title: 'NEP 2020', body: "India's National Education Policy now requires every school to start teaching computational thinking and AI basics from Class 3 onward." },
  { title: 'CBSE Code 417', body: 'CBSE now grades Artificial Intelligence as a formal Skill Subject in Grades 9 and 10 — not an elective. Schools need people who can actually teach it, not just a textbook.' },
  { title: 'Generative AI boom', body: "Every teenager already has ChatGPT in their pocket. Parents want to know their kids are learning from it safely — not just copying answers." },
  { title: 'Teacher gap', body: "The government has 45-hour teacher-training programs on paper. What's missing is hands-on, project-based teaching that's ready to use in a real classroom." },
];
---
<BaseLayout title="About">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="font-display text-3xl font-bold text-ink-950 sm:text-4xl">Why now</h1>
    <p class="mt-2 text-ink-600">
      Government policy, the new CBSE syllabus, and growing parent concern are all lining up in the same two years.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {whyNow.map((item) => (
        <div class="rounded-2xl border border-indigo-100 bg-cream-50 p-5 shadow-sm transition-shadow hover:shadow-md">
          <h2 class="font-display font-semibold text-ink-950">{item.title}</h2>
          <p class="mt-1 text-sm text-ink-600">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-ink-950 text-white">
    <div class="max-w-3xl mx-auto px-4 py-16">
      <h2 class="font-display text-2xl font-bold sm:text-3xl">Our vision</h2>
      <p class="mt-4 text-lg text-ink-100/90">
        In three years, thousands of Indian teenagers — a meaningful share of them from government and rural schools — will be able to explain how AI works, build something useful with it, and question it critically.
      </p>
      <p class="mt-4 text-ink-100/70">
        Not a coding camp. Not a certificate mill. National infrastructure for a generation that will be judged on whether it can create with AI — not just consume it.
      </p>
    </div>
  </section>
</BaseLayout>
