---
import BaseLayout from '../layouts/BaseLayout.astro';

const whyNow = [
  { title: 'NEP 2020', body: 'National Education Policy mandates computational thinking & AI exposure from Class 3 onward.' },
  { title: 'CBSE Code 417', body: 'Artificial Intelligence made a formal Skill Subject for Grades 9–10 — schools now need delivery partners, not just textbooks.' },
  { title: 'Generative AI boom', body: "ChatGPT-era tools are already in every teenager's pocket — parents are actively searching for structured, safe guidance." },
  { title: 'Teacher gap', body: "Government SOAR-style 45-hour teacher modules exist, but classroom-ready, project-based delivery at scale doesn't." },
];
---
<BaseLayout title="About">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-slate-900">Why now</h1>
    <p class="mt-2 text-slate-600">
      Policy, curriculum, and parent anxiety are converging in the same 24 months.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {whyNow.map((item) => (
        <div class="rounded-lg border border-slate-200 p-5">
          <h2 class="font-semibold text-slate-900">{item.title}</h2>
          <p class="mt-1 text-sm text-slate-600">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-slate-900 text-white">
    <div class="max-w-3xl mx-auto px-4 py-16">
      <h2 class="text-2xl font-bold">Our vision</h2>
      <p class="mt-4 text-lg text-slate-200">
        In three years, thousands of Indian teenagers — with a meaningful share from government and rural schools — will be able to explain how AI works, build something useful with it, and question it critically.
      </p>
      <p class="mt-4 text-slate-300">
        Not a coding camp. Not a certificate mill. National infrastructure for a generation that will be judged on whether it can create with AI — not just consume it.
      </p>
    </div>
  </section>
</BaseLayout>
