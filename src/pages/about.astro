---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const whyNow = [
  { title: "CBSE's Computational Thinking & AI curriculum, Classes 3–8", body: "India's National Education Policy pushed computational thinking and AI into school education, and CBSE has now introduced Computational Thinking & AI as an integrated part of the curriculum for Classes 3 to 8 from session 2026-27, with higher classes following. Classes 3 to 5 meet it inside existing subjects like Mathematics and EVS through unplugged activities, puzzles and logical reasoning — deliberately no new textbook and no extra screen time. Classes 6 to 8 go deeper: AI awareness, organising data, the lifecycle of a project, and ethics including algorithmic bias. Teachers weave it into daily lessons, supported by official board handbooks for students and teachers." },
  { title: 'Curriculum-integrated, not opt-in', body: "Because it sits inside subjects every student already takes, every child in Classes 3 to 8 meets these ideas — there is no opting out and no separate elective to choose. Ages 10 to 15 spans roughly Classes 5 to 10, so the students we teach are the same cohort now meeting AI in their regular timetable, not only the smaller group who later choose an optional Skill Subject." },
  { title: 'CBSE Code 417', body: 'In Grades 9 and 10, Artificial Intelligence remains a board-recognised optional Skill Subject — substantial and practical, at 210 hours per year. Schools that choose to offer it need delivery partners, not just a textbook.' },
  { title: 'Generative AI boom', body: "Students already have ChatGPT in their pocket. Parents want to know their kids are learning from it safely — not just copying answers." },
  { title: 'Teacher gap', body: "The government has 45-hour teacher-training programs on paper. What's missing is hands-on, project-based teaching that's ready to use in a real classroom." },
];
---
<BaseLayout
  title="About Us: Why AI Literacy Now · Young AI Engineers Lab"
  description="Why we built an AI lab for Indian students aged 10–15: CBSE's Computational Thinking & AI curriculum for Classes 3–8 from session 2026-27, Code 417, and the teacher gap."
>
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="font-display text-3xl font-bold text-ink-950 sm:text-4xl">Why now</h1>
    <p class="mt-2 text-ink-600">
      Government policy, the new CBSE syllabus, and growing parent concern are all lining up in the same two years. The clearest signal: from session 2026-27, Computational Thinking &amp; AI is an integrated part of CBSE's curriculum for Classes 3 to 8 — taught inside subjects every student already takes, rather than offered as a choice.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {whyNow.map((item) => (
        <div class="rounded-2xl border border-indigo-100 bg-cream-50 p-5 shadow-sm transition-shadow hover:shadow-md">
          <h2 class="font-display font-semibold text-ink-950">{item.title}</h2>
          <p class="mt-1 text-sm text-ink-600">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-ink-950 text-white">
    <div class="max-w-3xl mx-auto px-4 py-16">
      <h2 class="font-display text-2xl font-bold sm:text-3xl">Our vision</h2>
      <p class="mt-4 text-lg text-ink-100/90">
        In three years, thousands of Indian school students — a meaningful share of them from government and rural schools — will be able to explain how AI works, build something useful with it, and question it critically.
      </p>
      <p class="mt-4 text-ink-100/70">
        Not a coding camp. Not a certificate mill. National infrastructure for a generation that will be judged on whether it can create with AI — not just consume it.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={`${base}/#how-it-works`} class="rounded-full border-2 border-indigo-400 px-5 py-2.5 text-center text-sm font-semibold text-white transition-colors hover:bg-indigo-600">
          See how the Winter Lab runs
        </a>
        <a href={`${base}/our-team/`} class="rounded-full border-2 border-white/25 px-5 py-2.5 text-center text-sm font-semibold text-white transition-colors hover:border-white/60 hover:bg-white/10">
          Meet the team
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
