---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// The LinkedIn button renders only when `linkedin` is a non-empty URL, so an
// unset profile never ships as a broken or wrong link.
const team = [
  {
    name: 'Balaji Bhat',
    role: 'Founder & CEO',
    linkedin: 'https://www.linkedin.com/in/balaji-b-9a63731a4/',
    bio: 'Leads enterprise sales and client relationships at a digital-engineering company backed by a global growth-equity fund. At The Young AI Engineers Lab, handles school partnerships, growth, and day-to-day operations.',
  },
  {
    name: 'Yash Kadam',
    role: 'Co-Founder & Head of Curriculum',
    linkedin: 'https://www.linkedin.com/in/yashkadam1899/',
    bio: 'An IIT Bombay graduate who works professionally in AI/ML. Personally designs and teaches every live session, so your child is learning from someone who builds AI for a living — not reading off a script.',
  },
];
---
<BaseLayout
  beat="calm"
  title="Our Team: Who Teaches the Lab · Young AI Engineers Lab"
  description="Meet the founders: Balaji Bhat, who runs partnerships and operations, and Yash Kadam, an IIT Bombay AI/ML practitioner who designs and teaches every session."
>
  <section class="max-w-narrow mx-auto px-gutter py-section">
    <h1 class="font-display text-h1 font-bold text-fg">Who's building this</h1>
    <p class="mt-2 max-w-prose text-fg-muted">
      Two founders: one who sells and runs it, one who designs and teaches it.
    </p>

    <div class="mt-stack grid gap-grid sm:grid-cols-2" data-reveal-stagger>
      {team.map((member) => (
        <div class="rounded-2xl border border-line bg-surface-raised p-6 shadow-sm transition-shadow hover:shadow-md">
          <div class="flex items-start justify-between gap-3">
            <div>
              <h2 class="font-display text-h3 font-semibold text-fg">{member.name}</h2>
              <span class="mt-0.5 block text-small font-medium text-accent">{member.role}</span>
            </div>
            {member.linkedin && (
              <a
                href={member.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${member.name} on LinkedIn`}
                title={`${member.name} on LinkedIn`}
                class="relative isolate -m-1.5 shrink-0 p-3 text-accent transition-colors before:absolute before:inset-1.5 before:-z-10 before:rounded-lg before:transition-colors hover:text-accent-strong hover:before:bg-surface-tint"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                  <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zm1.78 13.02H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
                </svg>
              </a>
            )}
          </div>
          <p class="mt-3 text-small text-fg-muted">{member.bio}</p>
        </div>
      ))}
    </div>

    <p class="mt-8 text-small text-fg-muted">
      See <a href={`${base}/#how-it-works`} class="font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 hover:text-accent-strong">how the Winter Lab runs</a>, or <a href={`${base}/contact/`} class="font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 hover:text-accent-strong">get in touch</a>.
    </p>
  </section>
</BaseLayout>
