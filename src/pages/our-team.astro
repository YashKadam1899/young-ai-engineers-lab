---
import BaseLayout from '../layouts/BaseLayout.astro';

const team = [
  {
    role: 'Founder & CEO',
    bio: 'B2B sales & client engagement leader, currently driving enterprise outbound and executive relationships at a digital-engineering firm backed by a global growth-equity fund. Owns GTM, school partnerships, and operations.',
  },
  {
    role: 'Co-Founder & Head of Curriculum',
    bio: 'IIT Bombay alumnus and AI/ML practitioner. Designs and personally delivers the live curriculum; anchors the credibility that drives parent trust and conversion.',
  },
];
---
<BaseLayout title="Our Team">
  <section class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="font-display text-3xl font-bold text-ink-950 sm:text-4xl">A B2B GTM operator paired with an IIT Bombay AI practitioner</h1>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {team.map((member) => (
        <div class="rounded-2xl border border-indigo-100 bg-cream-50 p-6 shadow-sm transition-shadow hover:shadow-md">
          <h2 class="font-display font-semibold text-ink-950">{member.role}</h2>
          <p class="mt-2 text-sm text-ink-600">{member.bio}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
