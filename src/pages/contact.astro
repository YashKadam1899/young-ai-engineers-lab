---
import BaseLayout from '../layouts/BaseLayout.astro';

const CONTACT_EMAIL = 'hello@youngaiengineerslab.com'; // TODO: replace with a real, monitored inbox before launch

const channels = [
  { label: 'Parents & Students', description: 'Ask about enrollment, the Winter Lab schedule, or pricing.', subject: 'Enrollment enquiry' },
  { label: 'Schools & Partners', description: 'Bring the curriculum to your school, or discuss a CSR partnership.', subject: 'School partnership enquiry' },
  { label: 'Press & Media', description: 'Media inquiries and interview requests.', subject: 'Media enquiry' },
];
---
<BaseLayout title="Contact Us">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="font-display text-3xl font-bold text-ink-950 sm:text-4xl">Get in touch</h1>
    <p class="mt-2 text-ink-600">
      Choose the option below. It opens your email app with our address and the right subject line already filled in — just add your message.
    </p>
    <div class="mt-8 space-y-4">
      {channels.map((c) => (
        <a
          href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(c.subject)}`}
          class="group block rounded-2xl border border-indigo-100 bg-cream-50 p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md"
        >
          <span class="font-display font-semibold text-ink-950 group-hover:text-indigo-600">{c.label}</span>
          <p class="mt-1 text-sm text-ink-600">{c.description}</p>
          <span class="block text-sm text-ink-500">{CONTACT_EMAIL}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
