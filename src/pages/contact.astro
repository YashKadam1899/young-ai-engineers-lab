---
import BaseLayout from '../layouts/BaseLayout.astro';

const CONTACT_EMAIL = 'hello@youngaiengineerslab.com'; // TODO: replace with a real, monitored inbox before launch

const channels = [
  { label: 'Parents & Students', subject: 'Enrollment enquiry' },
  { label: 'Schools & Partners', subject: 'School partnership enquiry' },
  { label: 'Press & Media', subject: 'Media enquiry' },
];
---
<BaseLayout title="Contact Us">
  <section class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-slate-900">Get in touch</h1>
    <p class="mt-2 text-slate-600">
      Pick the option below that matches you best — each opens an email pre-addressed to us.
    </p>
    <div class="mt-8 space-y-4">
      {channels.map((c) => (
        <a
          href={`mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(c.subject)}`}
          class="block rounded-lg border border-slate-200 p-5 hover:bg-slate-50"
        >
          <span class="font-semibold text-slate-900">{c.label}</span>
          <span class="block text-sm text-slate-500">{CONTACT_EMAIL}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
