---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAILS, mailto } from '../emails';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// One address per audience — see src/emails.ts for the note on inbox status.
const channels = [
  {
    label: 'Parents & Students',
    description: 'Ask about enrollment, the Winter Lab schedule, dates or fees.',
    email: EMAILS.learn,
    subject: 'Enrollment enquiry',
  },
  {
    // Merged: both routes already pointed at partner@, so this is one audience
    // with two entry points rather than two channels.
    label: 'Schools, CSR & State Partners',
    description: 'Bring the curriculum to your school, or fund an implementation in state government or rural schools.',
    email: EMAILS.partner,
    subject: 'School, CSR or state partnership enquiry',
  },
  {
    label: 'Press & Media',
    description: 'Media enquiries and interview requests.',
    email: EMAILS.press,
    subject: 'Media enquiry',
  },
];
---
<BaseLayout
  beat="calm"
  title="Contact Us — Parents & Schools · Young AI Engineers Lab"
  description="Email the right person directly: Winter Lab enrollment for parents and students, school partnerships, CSR and state funding, or press enquiries."
>
  <section class="max-w-narrow mx-auto px-gutter py-section">
    <h1 class="font-display text-h1 font-bold text-fg">Get in touch</h1>
    <p class="mt-2 max-w-prose text-fg-muted">
      Choose the option below. It opens your email app with the right address and subject line already filled in — just add your message.
    </p>
    <div class="mt-stack space-y-4">
      {channels.map((c) => (
        <a
          href={mailto(c.email, c.subject)}
          class="group block rounded-2xl border border-line bg-surface-raised p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-accent-soft hover:shadow-md"
        >
          <h2 class="font-display text-h3 font-semibold text-fg group-hover:text-accent">{c.label}</h2>
          <p class="mt-1 text-small text-fg-muted">{c.description}</p>
          <span class="block text-small text-fg-subtle">{c.email}</span>
        </a>
      ))}
    </div>
    <p class="mt-8 text-small text-fg-muted">
      Investors: see the <a href={`${base}/for-investors/`} class="font-semibold text-accent underline decoration-link-underline decoration-2 underline-offset-4 hover:text-accent-strong">investor overview</a> to request the full deck.
    </p>
  </section>
</BaseLayout>
