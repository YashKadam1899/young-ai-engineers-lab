---
import BaseLayout from '../layouts/BaseLayout.astro';
import { EMAILS, mailto } from '../emails';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// One address per audience — see src/emails.ts for the note on inbox status.
const channels = [
  {
    label: 'Parents & Students',
    description: 'Ask about enrollment, the Winter Lab schedule, dates or fees.',
    email: EMAILS.learn,
    subject: 'Enrollment enquiry',
  },
  {
    label: 'Schools & Partners',
    description: 'Bring the curriculum to your school as a CBSE Code 417 delivery partner.',
    email: EMAILS.partner,
    subject: 'School partnership enquiry',
  },
  {
    label: 'CSR & State Partnerships',
    description: 'Fund an implementation in government or rural schools.',
    email: EMAILS.partner,
    subject: 'CSR or state partnership enquiry',
  },
  {
    label: 'Press & Media',
    description: 'Media enquiries and interview requests.',
    email: EMAILS.press,
    subject: 'Media enquiry',
  },
];
---
<BaseLayout
  title="Contact Us — Parents & Schools · Young AI Engineers Lab"
  description="Email the right person directly: Winter Lab enrollment for parents and students, CBSE Code 417 school partnerships, CSR and state funding, or press enquiries."
>
  <section class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="font-display text-3xl font-bold text-ink-950 sm:text-4xl">Get in touch</h1>
    <p class="mt-2 text-ink-600">
      Choose the option below. It opens your email app with the right address and subject line already filled in — just add your message.
    </p>
    <div class="mt-8 space-y-4">
      {channels.map((c) => (
        <a
          href={mailto(c.email, c.subject)}
          class="group block rounded-2xl border border-indigo-100 bg-cream-50 p-5 shadow-sm transition-all hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-md"
        >
          <h2 class="font-display font-semibold text-ink-950 group-hover:text-indigo-600">{c.label}</h2>
          <p class="mt-1 text-sm text-ink-600">{c.description}</p>
          <span class="block text-sm text-ink-400">{c.email}</span>
        </a>
      ))}
    </div>
    <p class="mt-8 text-sm text-ink-600">
      Investors: see the <a href={`${base}/for-investors/`} class="font-semibold text-indigo-600 underline decoration-coral-300 decoration-2 underline-offset-4 hover:text-indigo-700">investor overview</a> to request the full deck.
    </p>
  </section>
</BaseLayout>
