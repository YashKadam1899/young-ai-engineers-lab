---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RobotsMeta from '../components/RobotsMeta.astro';
import MotionLayer from '../components/motion/MotionLayer.astro';
import {
  OG_IMAGE_ALT,
  OG_IMAGE_PATH,
  SITE_LOCALE,
  SITE_SHORT_NAME,
  absoluteUrl,
  canonicalUrl as pageCanonicalUrl,
  organizationSchema,
} from '../seo';
import '../styles/global.css';

interface Props {
  /** The full <title>, already including the brand suffix. ~50–60 chars. */
  title: string;
  /** Meta description and og/twitter description. ~140–160 chars. */
  description: string;
  /** Defaults to `title`; set it where the brand suffix reads badly in a share card. */
  ogTitle?: string;
  ogType?: 'website' | 'article';
  /** Page-specific JSON-LD nodes. The organization node is added automatically. */
  schema?: Record<string, unknown>[];
  /** Story beat for the whole <main> (see the [data-beat] blocks in the palette files). Omit on the homepage, whose sections carry their own. */
  beat?: 'calm' | 'investor';
}
const { title, description, ogTitle = title, ogType = 'website', schema = [] } = Astro.props;

// Canonical/og:url come from Astro.site (the one hostname setting, in
// astro.config.mjs) plus Astro.url.pathname, which already carries the
// configured `base`. Nothing here hardcodes a host or a base path.
// Same helper RobotsMeta uses for <link rel="canonical">, so og:url always
// equals the canonical: in an archive build (PUBLIC_PREVIEW=1) both point at
// the matching live page, not at the archive page itself.
const canonicalUrl = pageCanonicalUrl(Astro.site, Astro.url);
const ogImageUrl = absoluteUrl(Astro.site, OG_IMAGE_PATH);
const faviconBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const faviconSvgHref = `${faviconBase}/favicon.svg`;
const faviconIcoHref = `${faviconBase}/favicon.ico`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [organizationSchema(Astro.site), ...schema],
};
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.dataset.motion='ok'</script>
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <RobotsMeta />
    <link rel="icon" href={faviconIcoHref} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={faviconSvgHref} sizes="any" />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_SHORT_NAME} />
    <meta property="og:locale" content={SITE_LOCALE} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-screen flex flex-col bg-surface text-fg antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:border focus:border-line focus:bg-surface-raised focus:px-4 focus:py-2 focus:text-small focus:font-semibold focus:text-fg focus:shadow-xl">Skip to main content</a>
    <Header />
    {/* Bottom breathing room sits inside main, so it takes the beat colour. A
        margin on the footer exposed the body colour as a stray stripe. */}
    <main id="main" tabindex="-1" class:list={["flex-1 bg-surface outline-none", Astro.props.beat && "pb-16"]} data-beat={Astro.props.beat}>
      <slot />
    </main>
    <Footer />
    <MotionLayer />
  </body>
</html>
